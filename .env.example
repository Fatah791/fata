# Keystatic GitHub OAuth credentials
# Create a GitHub OAuth app at: https://github.com/settings/developers
# Authorization callback URL: https://your-domain.com/api/keystatic/github/authorize
KEYSTATIC_GITHUB_CLIENT_ID=your_github_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_client_secret

# Keystatic secret (used for signing session cookies)
# Generate a random string: openssl rand -base64 32
KEYSTATIC_SECRET=your_random_secret_string

# GitHub token for content access (optional, for private repos)
GITHUB_TOKEN=your_github_token
