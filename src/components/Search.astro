---
/**
 * Search Component - جستجو با پشتیبانی از پیشنهادات و پاک‌سازی
 * ناوبری جستجو از طریق فرم GET انجام می‌شود.
 */
interface Props {
  placeholder?: string;
  value?: string;
  class?: string;
  'data-testid'?: string;
}

const {
  placeholder = 'جستجو...',
  value = '',
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;
---

<div class={`relative ${className}`} data-search-root data-testid={testId}>
  <label for="search-input" class="sr-only">{placeholder}</label>

  <div class="relative">
    <svg
      class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[color:var(--text-muted)] pointer-events-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>

    <input
      {...attrs}
      id="search-input"
      type="search"
      value={value}
      placeholder={placeholder}
      class="input input-md pl-10 pr-10"
      autocomplete="off"
      spellcheck="false"
    />

    {value && (
      <button
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 p-1 rounded hover:bg-[var(--bg-tertiary)] transition-colors text-[color:var(--text-muted)] hover:text-[color:var(--text-primary)]"
        aria-label="پاک کردن جستجو"
        data-search-clear
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    )}
  </div>
</div>

<script>
  // Client-side search enhancements: clear button visibility, suggestions UX.
  // NOTE: frontmatter callbacks (onSearch/onClear) cannot be serialized from the
  // server to the browser; navigation is handled via a plain GET form instead.
  (function() {
    const search = document.querySelector('[data-testid="header-search"], [data-search-root]');
    const root = search ?? document.querySelector('input[type="search"]')?.closest('div');
    if (!root) return;

    const input = root.querySelector('input[type="search"]') as HTMLInputElement | null;
    const clearBtn = root.querySelector('[data-search-clear]');
    const suggestionsList = root.querySelector('[role="listbox"]');

    function handleInput() {
      // Show/hide clear button based on current value
      clearBtn?.classList.toggle('hidden', !input?.value);

      // Update aria-expanded
      input?.setAttribute(
        'aria-expanded',
        suggestionsList && suggestionsList.children.length && !suggestionsList.classList.contains('hidden')
          ? 'true'
          : 'false'
      );
    }

    function handleClear() {
      if (input) {
        input.value = '';
        input.focus();
      }
      clearBtn?.classList.add('hidden');
      handleInput();
    }

    function handleSuggestionClick(e: MouseEvent) {
      const btn = e.currentTarget as HTMLElement;
      const value = btn.getAttribute('data-suggestion-value');
      if (value && input) {
        input.value = value;
        input.focus();
        input.form?.submit();
      }
      suggestionsList?.classList.add('hidden');
      input?.setAttribute('aria-expanded', 'false');
    }

    function handleKeydown(e: KeyboardEvent) {
      if (!suggestionsList || suggestionsList.classList.contains('hidden')) return;

      const items = Array.from(suggestionsList.querySelectorAll('[data-suggestion-value]')) as HTMLElement[];
      const currentIndex = items.findIndex(item => item === document.activeElement);

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          items[(currentIndex + 1) % items.length]?.focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          items[(currentIndex - 1 + items.length) % items.length]?.focus();
          break;
        case 'Enter':
          if (currentIndex >= 0) {
            e.preventDefault();
            items[currentIndex].click();
          }
          break;
        case 'Escape':
          suggestionsList.classList.add('hidden');
          input?.setAttribute('aria-expanded', 'false');
          input?.focus();
          break;
      }
    }

    input?.addEventListener('input', handleInput);
    input?.addEventListener('focus', () => {
      if (suggestionsList?.children.length) {
        suggestionsList.classList.remove('hidden');
        input?.setAttribute('aria-expanded', 'true');
      }
    });
    input?.addEventListener('keydown', handleKeydown);
    clearBtn?.addEventListener('click', handleClear);
    root.querySelectorAll('[data-suggestion-value]').forEach(btn => {
      btn.addEventListener('click', handleSuggestionClick);
    });

    // Close suggestions on outside click
    document.addEventListener('click', (e: MouseEvent) => {
      if (!root.contains(e.target as Node)) {
        suggestionsList?.classList.add('hidden');
        input?.setAttribute('aria-expanded', 'false');
      }
    });

    handleInput();
  })();
</script>

<style>
  /* Search uses global input styles */
</style>