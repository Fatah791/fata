---
/**
 * Search Component - جستجوی پیشرفته با Debounce و Keyboard Navigation
 */
interface Props {
  placeholder?: string;
  value?: string;
  onSearch?: (query: string) => void;
  onClear?: () => void;
  suggestions?: string[];
  loading?: boolean;
  class?: string;
  'data-testid'?: string;
}

const {
  placeholder = 'جستجو...',
  value = '',
  onSearch,
  onClear,
  suggestions = [],
  loading = false,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;
---

<div class="relative" data-testid={testId}>
  <label for="search-input" class="sr-only">{placeholder}</label>

  <div class="relative">
    <svg
      class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted pointer-events-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>

    {loading && (
      <svg
        class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-brand animate-spin"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" stroke-opacity="0.25" />
        <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" />
      </svg>
    )}

    <input
      {...attrs}
      id="search-input"
      type="search"
      value={value}
      placeholder={placeholder}
      class="input input-md pl-10 pr-10 {loading ? 'pl-14' : ''} {value || suggestions.length ? 'rounded-b-none' : ''}"
      aria-autocomplete={suggestions.length ? 'list' : 'none'}
      aria-controls={suggestions.length ? `${testId}-suggestions` : undefined}
      aria-expanded={suggestions.length > 0}
      autocomplete="off"
      spellcheck="false"
    />

    {value && (
      <button
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 p-1 rounded hover:bg-bg-tertiary transition-colors text-text-muted hover:text-text-primary"
        aria-label="پاک کردن جستجو"
        data-search-clear
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    )}
  </div>

  {suggestions.length > 0 && (
    <ul
      id={`${testId}-suggestions`}
      class="absolute top-full left-0 right-0 mt-1 glass-strong rounded-b-xl border border-border-primary border-t-0 shadow-2xl py-1 max-h-60 overflow-y-auto z-50 animate-scale-in"
      role="listbox"
      aria-label="پیشنهادات جستجو"
    >
      {suggestions.map((suggestion, index) => (
        <li role="option" key={suggestion}>
          <button
            type="button"
            class="w-full px-3 py-2 text-right text-sm hover:bg-bg-tertiary focus:bg-bg-tertiary focus:outline-none transition-colors flex items-center gap-2"
            data-suggestion-value={suggestion}
          >
            <svg class="w-4 h-4 text-text-muted flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>{suggestion}</span>
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  // Client-side search with debounce
  (function() {
    const search = document.currentScript?.parentElement;
    if (!search) return;

    const input = search.querySelector('input[type="search"]');
    const clearBtn = search.querySelector('[data-search-clear]');
    const suggestionsList = search.querySelector('[role="listbox"]');
    const suggestionButtons = search.querySelectorAll('[data-suggestion-value]');

    let debounceTimer: ReturnType<typeof setTimeout>;
    const DEBOUNCE_MS = 300;

    function handleInput(e: Event) {
      const target = e.target as HTMLInputElement;
      const value = target.value;

      // Show/hide clear button
      clearBtn?.classList.toggle('hidden', !value);

      // Update aria-expanded
      target.setAttribute('aria-expanded', suggestionsList?.children.length ? 'true' : 'false');

      // Debounced search
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (onSearch) {
          onSearch(value);
        }
      }, DEBOUNCE_MS);
    }

    function handleClear() {
      if (input) {
        input.value = '';
        input.focus();
      }
      clearBtn?.classList.add('hidden');
      if (onClear) onClear();
      if (onSearch) onSearch('');
    }

    function handleSuggestionClick(e: MouseEvent) {
      const btn = e.currentTarget as HTMLElement;
      const value = btn.getAttribute('data-suggestion-value');
      if (value && input) {
        input.value = value;
        input.focus();
        if (onSearch) onSearch(value);
      }
      suggestionsList?.classList.add('hidden');
      input?.setAttribute('aria-expanded', 'false');
    }

    function handleKeydown(e: KeyboardEvent) {
      if (!suggestionsList || suggestionsList.classList.contains('hidden')) return;

      const items = Array.from(suggestionsList.querySelectorAll('[data-suggestion-value]')) as HTMLElement[];
      const currentIndex = items.findIndex(item => item === document.activeElement);

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          const nextIndex = (currentIndex + 1) % items.length;
          items[nextIndex]?.focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          const prevIndex = (currentIndex - 1 + items.length) % items.length;
          items[prevIndex]?.focus();
          break;
        case 'Enter':
          if (currentIndex >= 0) {
            e.preventDefault();
            items[currentIndex].click();
          }
          break;
        case 'Escape':
          suggestionsList.classList.add('hidden');
          input?.setAttribute('aria-expanded', 'false');
          input?.focus();
          break;
      }
    }

    input?.addEventListener('input', handleInput);
    input?.addEventListener('focus', () => {
      if (suggestionsList?.children.length) {
        suggestionsList.classList.remove('hidden');
        input?.setAttribute('aria-expanded', 'true');
      }
    });
    input?.addEventListener('keydown', handleKeydown);
    clearBtn?.addEventListener('click', handleClear);

    suggestionButtons.forEach(btn => {
      btn.addEventListener('click', handleSuggestionClick);
    });

    // Close suggestions on outside click
    document.addEventListener('click', (e: MouseEvent) => {
      if (!search.contains(e.target as Node)) {
        suggestionsList?.classList.add('hidden');
        input?.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

<style>
  /* Search uses global input styles */
</style>