---
import { getAllCategories } from '../lib/keystatic-content';

interface Category {
  slug: string;
  data: {
    title?: string | { name: string };
    description?: string;
    icon?: string;
    color?: string;
    order?: number;
    [key: string]: unknown;
  };
}

const categories = (await getAllCategories()) as unknown as Category[];

// Helper to get title (handles both string and object)
function getTitle(data: { title?: string | { name: string } }): string {
  if (!data.title) return '';
  if (typeof data.title === 'string') return data.title;
  return data.title.name || '';
}
---
<section class="py-16 bg-surface-container-low px-margin-mobile md:px-margin-desktop">
  <div class="max-w-screen-2xl mx-auto w-full">
    <div class="text-center mb-8">
      <h2 class="font-headline-md text-headline-md text-on-surface mb-2">دسته‌بندی‌های پرطرفدار</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">در میان محبوب‌ترین خدمات جستجو کنید.</p>
    </div>

    {categories.length === 0 ? (
      <div class="text-center py-12 text-on-surface-variant">
        <span class="material-symbols-outlined text-4xl mb-4">category</span>
        <p>هنوز دسته‌بندی‌ای اضافه نشده است.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4">
        {categories.map((category) => (
          <a
            class="flex flex-col items-center justify-center p-6 bg-surface rounded-xl border border-surface-variant/50 hover:border-primary/50 hover:bg-surface-container transition-all group hover:shadow-[0_0_25px_rgba(232,184,74,0.1)]"
            href={`/categories/${category.slug}`}
          >
            <div
              class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-primary/20 transition-all"
              style={category.data.color ? `background-color: ${category.data.color}20;` : ''}
            >
              <span
                class="material-symbols-outlined text-3xl text-primary"
                style={category.data.color ? `color: ${category.data.color};` : ''}
              >
                {category.data.icon || 'category'}
              </span>
            </div>
            <span class="font-label-md text-on-surface">{getTitle(category.data)}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
