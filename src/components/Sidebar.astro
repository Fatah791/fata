---
export interface Props {
  toc?: { text: string; id: string; level?: number }[];
}
const { toc = [] } = Astro.props;
---

<aside class="hidden lg:block w-64 sticky top-20 flex-shrink-0">
  <nav class="p-4 rounded-xl border border-white/6 bg-surface">
    <h4 class="font-bold mb-3">فهرست محتوا</h4>
    <ul class="space-y-2 text-sm">
      {toc.map(item => (
        <li class={`pl-${(item.level||1)-1} text-muted`}>
          <a href={`#${item.id}`} class="block hover:text-accent transition-colors">{item.text}</a>
        </li>
      ))}
    </ul>
  </nav>
</aside>