---
/**
 * Accordion Component - اکاردئون‌های قابل دسترس با انیمیشن
 */
interface Props {
  items: Array<{
    id: string;
    title: string;
    content: string | AstroHTMLAttributes<'div'>['children'];
    icon?: string;
    disabled?: boolean;
  }>;
  allowMultiple?: boolean;
  class?: string;
  'data-testid'?: string;
}

const {
  items,
  allowMultiple = false,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;
---

<div class="space-y-2" data-testid={testId} {...attrs}>
  {items.map((item) => (
    <details
      class={[
        'group border border-border-primary rounded-xl overflow-hidden',
        'bg-bg-secondary transition-all duration-300',
        'hover:border-border-secondary',
        item.disabled && 'opacity-50 pointer-events-none',
        className,
      ].join(' ')}
      open={item.open}
      data-accordion-item
    >
      <summary
        class={[
          'flex items-center justify-between p-5 cursor-pointer list-none',
          'focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary',
          item.disabled && 'cursor-not-allowed',
        ].join(' ')}
        data-accordion-trigger
      >
        <div class="flex items-center gap-3">
          {item.icon && (
            <span class="flex-shrink-0 w-5 h-5 text-text-muted" aria-hidden="true">
              {item.icon}
            </span>
          )}
          <span class="font-medium text-text-primary rtl:pr-8">{item.title}</span>
        </div>
        <svg
          class="w-5 h-5 text-text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </summary>
      <div
        class="px-5 pb-5 text-text-secondary animate-fade-in"
        data-accordion-content
      >
        <slot name={item.id}>{item.content}</slot>
      </div>
    </details>
  ))}
</div>

<script>
  // Client-side accordion enhancement
  (function() {
    const accordion = document.currentScript?.parentElement;
    if (!accordion) return;

    const items = accordion.querySelectorAll('[data-accordion-item]');
    const triggers = accordion.querySelectorAll('[data-accordion-trigger]');

    // Allow multiple or single open
    function handleTriggerClick(e: Event) {
      const summary = e.target as HTMLElement;
      const details = summary.closest('details');
      if (!details) return;

      if (!allowMultiple) {
        // Close other items
        items.forEach(item => {
          if (item !== details && item.open) {
            item.removeAttribute('open');
          }
        });
      }
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('click', handleTriggerClick);
    });

    // Keyboard support for Enter/Space on summary
    triggers.forEach(trigger => {
      trigger.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          // Let the browser handle the toggle
        }
      });
    });
  })();
</script>

<style>
  /* Accordion uses global styles */
  summary::-webkit-details-marker { display: none; }
  summary::marker { display: none; }
</style>