---
/**
 * Card Component - کارت‌های مدرن، انیمیشند و انعطاف‌پذیر
 * וריאنت‌ها: default, elevated, outlined, glass, gradient
 * قابلیت‌ها: interactive, hover effects, focus states
 */
interface Props {
  variant?: 'default' | 'elevated' | 'outlined' | 'glass' | 'gradient';
  interactive?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  'data-testid'?: string;
}

const {
  variant = 'default',
  interactive = false,
  padding = 'md',
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const variantClasses = {
  default: 'card',
  elevated: 'card card-elevated',
  outlined: 'card card-outlined',
  glass: 'card card-glass',
  gradient: 'card card-gradient',
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
  xl: 'p-10',
};

const classes = [
  variantClasses[variant],
  interactive && 'card-interactive',
  paddingClasses[padding],
  className,
].filter(Boolean).join(' ');
---

<div
  {...attrs}
  class={classes}
  data-testid={testId}
  role={interactive ? 'button' : undefined}
  tabIndex={interactive ? 0 : undefined}
>
  <slot />
</div>

<style>
  /* Card styles are in global styles.css */
</style>