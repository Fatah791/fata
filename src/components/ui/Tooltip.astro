---
/**
 * Tooltip Component - تولتیپ‌های هوشمند با Positioning
 */
interface Props {
  content: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  delay?: number;
  class?: string;
  'data-testid'?: string;
}

const {
  content,
  position = 'top',
  delay = 200,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const positionClasses = {
  top: 'bottom-full left-1/2 -translate-x-1/2 mb-2',
  bottom: 'top-full left-1/2 -translate-x-1/2 mt-2',
  left: 'right-full top-1/2 -translate-y-1/2 mr-2',
  right: 'left-full top-1/2 -translate-y-1/2 ml-2',
};

const arrowClasses = {
  top: 'top-full left-1/2 -translate-x-1/2 border-t-border-primary',
  bottom: 'bottom-full left-1/2 -translate-x-1/2 border-b-border-primary',
  left: 'left-full top-1/2 -translate-y-1/2 border-l-border-primary',
  right: 'right-full top-1/2 -translate-y-1/2 border-r-border-primary',
};
---

<div class="relative inline-block" {...attrs} data-testid={testId}>
  <slot />

  <div
    class={[
      'absolute z-50 glass-strong px-3 py-1.5 text-xs font-medium text-text-primary',
      'rounded-lg shadow-lg border border-border-primary',
      'whitespace-nowrap opacity-0 invisible transition-all duration-200',
      'pointer-events-none',
      positionClasses[position],
      className,
    ].join(' ')}
    data-tooltip
    role="tooltip"
  >
    {content}
    <div
      class={[
        'absolute w-0 h-0 border-4 border-transparent',
        arrowClasses[position],
      ].join(' ')}
      aria-hidden="true"
    />
  </div>
</div>

<script>
  // Tooltip hover/focus logic
  (function() {
    const tooltip = document.currentScript?.parentElement;
    if (!tooltip) return;

    const trigger = tooltip.querySelector('slot')?.assignedElements()[0] || tooltip.firstElementChild;
    const tooltipEl = tooltip.querySelector('[data-tooltip]');

    let timeoutId: ReturnType<typeof setTimeout>;

    function show() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        tooltipEl?.classList.remove('opacity-0', 'invisible');
        tooltipEl?.classList.add('opacity-100', 'visible');
      }, delay);
    }

    function hide() {
      clearTimeout(timeoutId);
      tooltipEl?.classList.remove('opacity-100', 'visible');
      tooltipEl?.classList.add('opacity-0', 'invisible');
    }

    trigger?.addEventListener('mouseenter', show);
    trigger?.addEventListener('mouseleave', hide);
    trigger?.addEventListener('focus', show);
    trigger?.addEventListener('blur', hide);
  })();
</script>

<style>
  /* Tooltip uses global styles */
</style>