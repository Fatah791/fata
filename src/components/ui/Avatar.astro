---
/**
 * Avatar Component - آواتارهای کاربری با Fallback
 */
interface Props {
  src?: string;
  alt?: string;
  name?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  shape?: 'circle' | 'square';
  status?: 'online' | 'offline' | 'busy' | 'away';
  class?: string;
  'data-testid'?: string;
}

const {
  src,
  alt = '',
  name,
  size = 'md',
  shape = 'circle',
  status,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const sizeClasses = {
  xs: 'w-6 h-6 text-[10px]',
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-12 h-12 text-base',
  xl: 'w-16 h-16 text-lg',
  '2xl': 'w-24 h-24 text-xl',
};

const shapeClasses = {
  circle: 'rounded-full',
  square: 'rounded-xl',
};

const statusSizeClasses = {
  xs: 'w-1.5 h-1.5',
  sm: 'w-2 h-2',
  md: 'w-2.5 h-2.5',
  lg: 'w-3 h-3',
  xl: 'w-4 h-4',
  '2xl': 'w-5 h-5',
};

const statusColorClasses = {
  online: 'bg-status-success',
  offline: 'bg-text-muted',
  busy: 'bg-status-error',
  away: 'bg-status-warning',
};

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}

function getColorFromName(name: string): string {
  const colors = [
    'bg-brand-500',
    'bg-emerald-500',
    'bg-amber-500',
    'bg-rose-500',
    'bg-violet-500',
    'bg-cyan-500',
    'bg-indigo-500',
    'bg-pink-500',
  ];
  let hash = 0;
  for (let i = 0; i < name.length; i++) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

const classes = [
  'inline-flex items-center justify-center font-semibold text-text-inverse',
  'bg-gradient-to-br',
  'overflow-hidden',
  sizeClasses[size],
  shapeClasses[shape],
  className,
].filter(Boolean).join(' ');

const statusClasses = status
  ? [
      'absolute bottom-0 right-0',
      'rounded-full border-2 border-bg-primary',
      statusSizeClasses[size],
      statusColorClasses[status],
    ].join(' ')
  : '';
---

<div class="relative inline-block" data-testid={testId}>
  {src ? (
    <img
      {...attrs}
      src={src}
      alt={alt || (name ? `آواتار ${name}` : 'آواتار کاربر')}
      class={classes}
    />
  ) : (
    <div
      {...attrs}
      class={[
        classes,
        name ? getColorFromName(name) : 'bg-brand-500',
      ].join(' ')}
      aria-label={name ? `آواتار ${name}` : 'آواتار پیش‌فرض'}
    >
      {name ? getInitials(name) : '?'}
    </div>
  )}

  {status && (
    <span
      class={statusClasses}
      aria-label={`وضعیت: ${status === 'online' ? 'آنلاین' : status === 'offline' ? 'آفلاین' : status === 'busy' ? 'مشغول' : 'دور از دسترس'}`}
    />
  )}
</div>

<style>
  /* Avatar uses global styles */
</style>