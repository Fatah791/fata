---
/**
 * Skeleton Component - اسکلت‌های بارگذاری برای UX بهتر
 */
type Variant = 'text' | 'circular' | 'rectangular' | 'card' | 'avatar';

interface Props {
  variant?: Variant;
  width?: string | number;
  height?: string | number;
  class?: string;
  'data-testid'?: string;
}

const {
  variant = 'text',
  width = '100%',
  height,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const variantClasses = {
  text: 'h-4',
  circular: 'rounded-full',
  rectangular: 'rounded-lg',
  card: 'rounded-xl',
  avatar: 'rounded-full',
};

const defaultHeights = {
  text: '1rem',
  circular: '1rem',
  rectangular: '1rem',
  card: '12rem',
  avatar: '3rem',
};

const classes = [
  'skeleton',
  variantClasses[variant],
  className,
].filter(Boolean).join(' ');

const style = `width: ${width}; height: ${height || defaultHeights[variant]};`;
---

<div
  {...attrs}
  class={classes}
  style={style}
  data-testid={testId}
  aria-hidden="true"
  aria-label="در حال بارگذاری"
/>

<style>
  /* Skeleton styles are in global styles.css */
</style>