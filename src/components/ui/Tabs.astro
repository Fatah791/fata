---
/**
 * Tabs Component - تبهای قابل دسترس با Keyboard Navigation
 */
interface Props {
  tabs: Array<{
    id: string;
    label: string;
    icon?: string;
    disabled?: boolean;
  }>;
  activeTab: string;
  onChange?: (tabId: string) => void;
  variant?: 'line' | 'pills' | 'enclosed';
  class?: string;
  'data-testid'?: string;
}

const {
  tabs,
  activeTab,
  onChange,
  variant = 'line',
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const variantClasses = {
  line: 'border-b border-border-primary',
  pills: 'gap-1',
  enclosed: 'gap-1',
};
---

<div class="relative" data-testid={testId}>
  <nav
    role="tablist"
    aria-label="تبها"
    class={[
      'flex',
      variantClasses[variant],
      className,
    ].join(' ')}
    {...attrs}
  >
    {tabs.map((tab) => (
      <button
        role="tab"
        id={`${testId}-tab-${tab.id}`}
        aria-selected={tab.id === activeTab}
        aria-controls={`${testId}-panel-${tab.id}`}
        tabIndex={tab.id === activeTab ? 0 : -1}
        disabled={tab.disabled}
        class={[
          'relative px-4 py-2.5 text-sm font-medium transition-all duration-200',
          'focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2',
          tab.disabled && 'opacity-50 cursor-not-allowed',
          tab.id === activeTab
            ? variant === 'line'
              ? 'text-brand border-b-2 border-brand -mb-px'
              : variant === 'pills'
              ? 'bg-brand/10 text-brand rounded-lg'
              : 'bg-bg-tertiary text-text-primary rounded-lg'
            : 'text-text-secondary hover:text-text-primary',
        ].join(' ')}
        data-tab={tab.id}
        data-tabs-trigger
      >
        {tab.icon && <span class="inline-flex items-center justify-center w-4 h-4 mr-2" aria-hidden="true">{tab.icon}</span>}
        {tab.label}
      </button>
    ))}
  </nav>

  {tabs.map((tab) => (
    <div
      role="tabpanel"
      id={`${testId}-panel-${tab.id}`}
      aria-labelledby={`${testId}-tab-${tab.id}`}
      hidden={tab.id !== activeTab}
      class={tab.id === activeTab ? 'animate-fade-in' : 'hidden'}
      data-tabs-panel
    >
      <slot name={tab.id} />
    </div>
  ))}
</div>

<script>
  // Client-side tabs with keyboard navigation
  (function() {
    const tabsContainer = document.currentScript?.parentElement;
    if (!tabsContainer) return;

    const triggers = tabsContainer.querySelectorAll('[data-tabs-trigger]');
    const panels = tabsContainer.querySelectorAll('[data-tabs-panel]');

    function activateTab(tabId: string) {
      triggers.forEach(trigger => {
        const isActive = trigger.getAttribute('data-tab') === tabId;
        trigger.setAttribute('aria-selected', isActive.toString());
        trigger.setAttribute('tabIndex', isActive ? '0' : '-1');
        if (isActive) {
          trigger.classList.add('text-brand', 'border-b-2', 'border-brand', '-mb-px');
          trigger.classList.remove('text-text-secondary');
        } else {
          trigger.classList.remove('text-brand', 'border-b-2', 'border-brand', '-mb-px');
          trigger.classList.add('text-text-secondary');
        }
      });

      panels.forEach(panel => {
        const isActive = panel.getAttribute('aria-labelledby')?.includes(tabId);
        panel.hidden = !isActive;
        if (isActive) {
          panel.classList.remove('hidden');
          panel.classList.add('animate-fade-in');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const tabId = trigger.getAttribute('data-tab');
        if (tabId && !trigger.disabled) {
          activateTab(tabId);
          if (onChange) onChange(tabId);
        }
      });

      trigger.addEventListener('keydown', (e: KeyboardEvent) => {
        const tabIds = Array.from(triggers).map(t => t.getAttribute('data-tab')).filter(Boolean) as string[];
        const currentIndex = tabIds.indexOf(trigger.getAttribute('data-tab') || '');

        switch (e.key) {
          case 'ArrowRight':
            e.preventDefault();
            const nextIndex = (currentIndex + 1) % tabIds.length;
            triggers[nextIndex]?.focus();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            const prevIndex = (currentIndex - 1 + tabIds.length) % tabIds.length;
            triggers[prevIndex]?.focus();
            break;
          case 'Home':
            e.preventDefault();
            triggers[0]?.focus();
            break;
          case 'End':
            e.preventDefault();
            triggers[triggers.length - 1]?.focus();
            break;
          case 'Enter':
          case ' ':
            e.preventDefault();
            trigger.click();
            break;
        }
      });
    });
  })();
</script>

<style>
  /* Tabs use global styles */
</style>