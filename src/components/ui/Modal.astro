---
/**
 * Modal Component - ماژولار، Accessible و انیمیشند
 * با Focus Trap، Escape Key، Backdrop Click
 */
interface Props {
  isOpen: boolean;
  title?: string;
  description?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  closeOnOverlayClick?: boolean;
  closeOnEscape?: boolean;
  showCloseButton?: boolean;
  class?: string;
  'data-testid'?: string;
}

const {
  isOpen,
  title,
  description,
  size = 'md',
  closeOnOverlayClick = true,
  closeOnEscape = true,
  showCloseButton = true,
  class: className = '',
  'data-testid': testId,
  ...attrs
} = Astro.props;

const sizeClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  full: 'max-w-4xl',
};

if (!isOpen) {
  // Render nothing when closed (Astro handles this at build time for static content)
  // For client-side interactivity, this would need a client directive
}
---

{isOpen && (
  <>
    <!-- Backdrop -->
    <div
      class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 animate-fade-in"
      data-testid={`${testId}-backdrop`}
      aria-hidden="true"
    />

    <!-- Modal -->
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-scale-in"
      role="dialog"
      aria-modal="true"
      aria-labelledby={title ? `${testId}-title` : undefined}
      aria-describedby={description ? `${testId}-description` : undefined}
      data-testid={testId}
    >
      <div
        {...attrs}
        class={[
          'glass-strong rounded-2xl shadow-2xl w-full',
          sizeClasses[size],
          'animate-scale-in',
          className,
        ].filter(Boolean).join(' ')}
      >
        {(title || showCloseButton) && (
          <header class="flex items-start justify-between p-6 border-b border-border-primary">
            <div>
              {title && (
                <h2
                  id={`${testId}-title`}
                  class="text-xl font-bold text-text-primary"
                >
                  {title}
                </h2>
              )}
              {description && (
                <p
                  id={`${testId}-description`}
                  class="mt-1 text-sm text-text-secondary"
                >
                  {description}
                </p>
              )}
            </div>
            {showCloseButton && (
              <button
                class="btn btn-ghost btn-sm p-2 rounded-full hover:bg-bg-tertiary transition-colors"
                aria-label="بستن مودال"
                data-testid={`${testId}-close`}
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            )}
          </header>
        )}

        <div class="p-6">
          <slot />
        </div>
      </div>
    </div>
  </>
)}

<script>
  // Client-side interactivity for modal
  if (import.meta.env.PROD) {
    // Focus trap implementation
    const modal = document.querySelector(`[data-testid="${testId}"]`);
    const closeBtn = document.querySelector(`[data-testid="${testId}-close"]`);
    const backdrop = document.querySelector(`[data-testid="${testId}-backdrop"]`);

    let lastFocusedElement: HTMLElement | null = null;

    function trapFocus(element: HTMLElement) {
      const focusableElements = element.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      element.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Tab') return;

        if (e.shiftKey) {
          if (document.activeElement === firstElement) {
            e.preventDefault();
            lastElement?.focus();
          }
        } else {
          if (document.activeElement === lastElement) {
            e.preventDefault();
            firstElement?.focus();
          }
        }
      });

      firstElement?.focus();
    }

    function openModal() {
      lastFocusedElement = document.activeElement as HTMLElement;
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      trapFocus(modal as HTMLElement);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      lastFocusedElement?.focus();
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', () => closeOnOverlayClick && closeModal());

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && closeOnEscape) {
        closeModal();
      }
    });
  }
</script>

<style>
  /* Modal uses global styles + inline utilities */
</style>