---
import { Search, ThemeToggle } from './ui';
---

<!-- Announcement Pill (Pulsar style) -->
<div class="announce-wrap">
  <a href="/posts/first-post" class="announce-pill">
    <span class="announce-dot" aria-hidden="true"></span>
    <span class="announce-text">راهنمای جدید منتشر شد</span>
    <span class="announce-arrow" aria-hidden="true">←</span>
  </a>
</div>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="header-logo">
        <div class="logo-icon"><span>ب</span></div>
        <span class="logo-title">بهترینها</span>
      </a>

      <nav class="header-nav" role="navigation" aria-label="منوی اصلی">
        <a href="/" class="nav-link">خانه</a>
        <a href="/posts" class="nav-link">مقالات</a>
        <a href="/posts?q=کارواش" class="nav-link">کارواش</a>
        <a href="/posts?q=رستوران" class="nav-link">رستوران</a>
        <a href="/posts?q=کافیشاپ" class="nav-link">کافیشاپ</a>
      </nav>

      <div class="header-actions">
        <Search
          placeholder="جستجو..."
          class="header-search"
        />

        <ThemeToggle />

        <a href="/posts" class="btn btn-primary btn-sm header-cta">کشف بهترینها</a>

        <button
          id="menu-toggle"
          class="menu-btn btn btn-ghost btn-sm p-2"
          aria-label="منو"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="mobile-menu hidden" role="dialog" aria-label="منوی موبایل">
  <div class="mobile-menu-content glass-strong">
    <nav class="mobile-nav">
      <a href="/" class="mobile-nav-link">صفحه اصلی</a>
      <a href="/posts" class="mobile-nav-link">مقالات</a>
    </nav>
    <div class="mobile-search">
      <Search placeholder="جستجو در سایت..." />
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-primary);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
    gap: var(--space-4);
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .header-logo:hover {
    transform: scale(1.02);
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--interactive-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    flex-shrink: 0;
  }

  .logo-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
  }

  /* Announcement pill (Pulsar style) */
  .announce-wrap {
    display: flex;
    justify-content: center;
    padding: var(--space-3) var(--space-4) 0;
  }

  .announce-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2-5);
    padding: 6px var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .announce-pill:hover {
    color: var(--text-primary);
    border-color: var(--border-secondary);
  }

  .announce-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--interactive-primary);
    flex-shrink: 0;
  }

  .announce-arrow {
    color: var(--text-muted);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    padding: var(--space-2) var(--space-3-5);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-search :global(.input) {
    width: 200px;
    padding: var(--space-2-5) var(--space-3) var(--space-2-5) var(--space-10);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-family: inherit;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .header-search :global(.input)::placeholder {
    color: var(--text-muted);
  }

  .header-search :global(.input):focus {
    outline: none;
    width: 260px;
    background: var(--bg-secondary);
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
  }

  .header-search svg {
    position: absolute;
    right: var(--space-3);
    color: var(--text-muted);
    pointer-events: none;
  }

  .menu-btn {
    display: none;
  }

  @media (max-width: 1024px) {
    .header-nav {
      display: none;
    }

    .header-search :global(.input) {
      width: 160px;
    }

    .header-search :global(.input):focus {
      width: 200px;
    }
  }

  @media (max-width: 768px) {
    .announce-wrap {
      display: none;
    }

    .header-search {
      display: none;
    }

    .menu-btn {
      display: flex;
    }

    .header-cta {
      display: none;
    }

    .logo-title {
      display: none;
    }

    .logo-icon {
      width: 36px;
      height: 36px;
      font-size: var(--text-xl);
    }
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .mobile-menu:not(.hidden) {
    display: block;
  }

  .mobile-menu-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 320px;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    animation: slideInRight 0.3s var(--ease-out);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .mobile-nav-link:hover {
    background: var(--bg-tertiary);
  }

  .mobile-search {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-primary);
  }
</style>

<script>
  // Mobile menu toggle
  (function() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!toggleBtn || !mobileMenu) return;

    function openMenu() {
      mobileMenu.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      // Focus first link
      const firstLink = mobileMenu.querySelector('.mobile-nav-link');
      firstLink?.focus();
    }

    function closeMenu() {
      mobileMenu.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn.focus();
    }

    toggleBtn.addEventListener('click', () => {
      if (mobileMenu.classList.contains('hidden')) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Close on backdrop click
    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        closeMenu();
      }
    });

    // Close on link click
    mobileMenu.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>