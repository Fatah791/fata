---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('posts', slug);

if (!post) throw new Error('No post found for this slug');
const { Content } = await render(post);

// Generate static pages
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id } }));
}
---

<Layout 
  title={post.data.title}
  description={post.data.description || post.data.title}
>
  <!-- Reading Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1 z-50 bg-gray-200">
    <div id="progress-bar" class="h-full bg-gradient-to-l from-red-600 to-red-700" style="width: 0%"></div>
  </div>

  <!-- Article Header with Featured Image -->
  <article class="relative">
    <div class="relative h-[400px] md:h-[500px] overflow-hidden">
      <img 
        src={post.data.image || 'https://picsum.photos/seed/article/1200/600'} 
        alt={post.data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/60 to-transparent"></div>
      
      <!-- Header Content -->
      <div class="absolute bottom-0 right-0 left-0 pb-12 md:pb-16">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <!-- Category & City Tags -->
            <div class="flex flex-wrap gap-3 mb-4">
              {post.data.category && (
                <span class="bg-red-600 text-white text-sm font-bold px-4 py-2 rounded-full shadow-lg">
                  {post.data.category}
                </span>
              )}
              {post.data.city && (
                <span class="bg-white/95 backdrop-blur-sm text-gray-800 text-sm font-bold px-4 py-2 rounded-full shadow-lg">
                  📍 {post.data.city}
                </span>
              )}
            </div>
            
            <!-- Title -->
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight drop-shadow-lg">
              {post.data.title}
            </h1>
            
            <!-- Meta Info -->
            <div class="flex flex-wrap items-center gap-6 text-white/90">
              {post.data.author && (
                <div class="flex items-center gap-3">
                  <img 
                    src={post.data.author.avatar || 'https://picsum.photos/seed/avatar/100/100'} 
                    alt={post.data.author.name}
                    class="w-12 h-12 rounded-full border-2 border-white/50"
                  />
                  <div>
                    <div class="font-bold">{post.data.author.name}</div>
                    <div class="text-sm text-white/70">نویسنده</div>
                  </div>
                </div>
              )}
              
              {post.data.date && (
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <span>{post.data.date}</span>
                </div>
              )}
              
              {post.data.readTime && (
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>{post.data.readTime} مطالعه</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content + Sidebar -->
    <div class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto">
        <!-- Main Content -->
        <main class="lg:col-span-8">
          <div class="bg-white rounded-3xl shadow-xl p-6 md:p-10 lg:p-12 border border-gray-100">
            <!-- Share Buttons (Top) -->
            <div class="flex items-center gap-3 mb-8 pb-8 border-b border-gray-200">
              <span class="text-gray-500 font-medium text-sm ml-2">اشتراک‌گذاری:</span>
              <button class="w-10 h-10 bg-blue-600 hover:bg-blue-700 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
              </button>
              <button class="w-10 h-10 bg-sky-500 hover:bg-sky-600 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.92 4.92 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
              </button>
              <button class="w-10 h-10 bg-green-500 hover:bg-green-600 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-110">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </button>
              <button class="w-10 h-10 bg-gray-700 hover:bg-gray-800 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-110 mr-auto">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                </svg>
              </button>
            </div>

            <!-- Article Content -->
            <div class="prose prose-lg prose-red max-w-none">
              <Content />
            </div>

            <!-- Tags -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-12 pt-8 border-t border-gray-200">
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map(tag => (
                    <a 
                      href={`/tags/${tag}`}
                      class="bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium px-4 py-2 rounded-xl transition-colors duration-300"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Author Bio Section -->
          {post.data.author && (
            <div class="mt-8 bg-gradient-to-br from-red-50 to-red-100 rounded-3xl p-8 border border-red-200">
              <div class="flex items-start gap-6">
                <img 
                  src={post.data.author.avatar || 'https://picsum.photos/seed/avatar/100/100'} 
                  alt={post.data.author.name}
                  class="w-20 h-20 rounded-2xl border-4 border-white shadow-lg"
                />
                <div class="flex-1">
                  <h3 class="text-xl font-black text-gray-900 mb-2">درباره {post.data.author.name}</h3>
                  <p class="text-gray-700 leading-relaxed mb-4">
                    {post.data.author.bio || 'نویسنده این مقاله'}
                  </p>
                  <div class="flex gap-3">
                    {post.data.author.social?.twitter && (
                      <a href={post.data.author.social.twitter} class="text-red-600 hover:text-red-700 transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.92 4.92 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Related Articles -->
          <div class="mt-12">
            <h3 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-3">
              <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
              </svg>
              مقالات مرتبط
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Placeholder for related articles - will be implemented dynamically -->
              <div class="card rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300">
                <img src="https://picsum.photos/seed/related1/400/250" alt="مقاله مرتبط" class="w-full h-40 object-cover" />
                <div class="p-5">
                  <h4 class="font-bold text-gray-900 mb-2 line-clamp-2">عنوان مقاله مرتبط نمونه</h4>
                  <p class="text-gray-600 text-sm line-clamp-2">خلاصه کوتاهی از مقاله مرتبط برای جذب کاربر به مطالعه بیشتر...</p>
                </div>
              </div>
              <div class="card rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300">
                <img src="https://picsum.photos/seed/related2/400/250" alt="مقاله مرتبط" class="w-full h-40 object-cover" />
                <div class="p-5">
                  <h4 class="font-bold text-gray-900 mb-2 line-clamp-2">عنوان مقاله مرتبط نمونه دوم</h4>
                  <p class="text-gray-600 text-sm line-clamp-2">خلاصه کوتاهی از مقاله مرتبط برای جذب کاربر به مطالعه بیشتر...</p>
                </div>
              </div>
            </div>
          </div>
        </main>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-6">
          <!-- Table of Contents (Sticky) -->
          <div class="sticky top-24 bg-white rounded-3xl shadow-xl p-6 border border-gray-100">
            <h3 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
              فهرست مطالب
            </h3>
            <nav class="space-y-2 text-sm">
              <a href="#intro" class="block text-gray-600 hover:text-red-600 transition-colors py-1">مقدمه</a>
              <a href="#main" class="block text-gray-600 hover:text-red-600 transition-colors py-1">بخش اصلی</a>
              <a href="#conclusion" class="block text-gray-600 hover:text-red-600 transition-colors py-1">نتیجه‌گیری</a>
            </nav>
            
            <!-- Newsletter Mini -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <h4 class="font-bold text-gray-900 mb-2 text-sm">عضویت در خبرنامه</h4>
              <p class="text-xs text-gray-600 mb-3">جدیدترین مقالات را دریافت کنید</p>
              <input 
                type="email" 
                placeholder="ایمیل شما"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm mb-2"
              />
              <button class="w-full btn btn-primary py-2.5 rounded-xl text-sm">
                عضویت
              </button>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- Back to Top Button -->
    <button 
      id="back-to-top"
      class="fixed bottom-8 left-8 w-14 h-14 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white rounded-2xl shadow-2xl flex items-center justify-center transition-all duration-300 transform translate-y-20 opacity-0 hover:scale-110 z-40"
      onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>
  </article>

  <script>
    // Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) {
        progressBar.style.width = scrolled + '%';
      }
      
      // Back to Top Button
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        if (winScroll > 500) {
          backToTop.classList.remove('translate-y-20', 'opacity-0');
        } else {
          backToTop.classList.add('translate-y-20', 'opacity-0');
        }
      }
    });
  </script>
</Layout>

<style>
  /* Prose Typography Styles for Article Content */
  .prose {
    font-size: 1.125rem;
    line-height: 2;
    color: var(--color-dark-800);
  }
  
  .prose h2 {
    font-size: 1.875rem;
    font-weight: 800;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-dark-900);
  }
  
  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-dark-900);
  }
  
  .prose p {
    margin-bottom: 1.5rem;
    text-align: justify;
  }
  
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-right: 1.5rem;
  }
  
  .prose li {
    margin-bottom: 0.5rem;
  }
  
  .prose a {
    color: var(--color-primary-600);
    text-decoration: underline;
    transition: color 0.2s ease;
  }
  
  .prose a:hover {
    color: var(--color-primary-700);
  }
  
  .prose blockquote {
    border-right: 4px solid var(--color-primary-500);
    padding-right: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-dark-700);
    background: var(--color-primary-50);
    padding: 1.5rem;
    border-radius: 1rem;
  }
  
  .prose img {
    border-radius: 1rem;
    margin: 2rem 0;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
