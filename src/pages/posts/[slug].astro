---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TOC from '../../components/TOC.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('posts', slug);

if (!post) throw new Error('No post found for this slug');
const { Content, headings = [] } = await render(post);

// Generate static pages
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id } }));
}
---

<Layout title={post.data.title}>
  <div class="grid lg:grid-cols-[1fr_320px] gap-8">
    <main class="article-container">
      <header class="article-hero">
        <h1 class="text-4xl font-extrabold">{post.data.title}</h1>
        <div class="article-meta">{post.data.date ? new Date(post.data.date).toLocaleDateString('fa-IR') : ''} {post.data.readingTime ? ` • ${post.data.readingTime}` : ''}</div>
        {post.data.image && <img src={post.data.image} alt={post.data.title} class="rounded-lg w-full h-auto" />}
      </header>

      <article class="article-content prose">
        <Content />
      </article>

      <nav class="mt-12 flex justify-between text-sm text-gray-400">
        <div></div>
        <div></div>
      </nav>
    </main>

    <aside class="hidden lg:block">
      <!-- TOC: extracted headings passed to component -->
      <TOC headings={headings} />
    </aside>
  </div>
</Layout>
