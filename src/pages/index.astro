---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
const ic = {
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4 5.6 4 9s-1.2 6.4-4 9c-2.8-2.6-4-5.6-4-9s1.2-6.4 4-9Z"/></svg>',
  db: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5V12c0 1.7 3.6 3 8 3s8-1.3 8-3V5.5M4 12v6.5c0 1.7 3.6 3 8 3s8-1.3 8-3V12"/></svg>',
  link: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 14a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.2 1.2"/><path d="M14 10a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.2-1.2"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 20v-8M11 20V5M17 20v-5"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5c0 4.6 3.2 8 7.5 10 4.3-2 7.5-5.4 7.5-10V6L12 3Z"/><path d="m9 11.5 2 2 4-4"/></svg>',
  key: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="15" r="4.5"/><path d="m11.5 11.5 8-8M17 4l3 3M14 7l2.5 2.5"/></svg>',
};

const features = [
  { size: 'lg', icon: ic.globe, title: 'شبکه توزیع کشوری', desc: 'صفحه کسبوکار شما از نزدیکترین لبهٔ شبکه به بازدیدکننده میرسد؛ سریع در تهران، سریع در هر شهری.', viz: 'map' },
  { size: '', icon: ic.db, title: 'دادههای لحظهای', desc: 'امتیازها و آمار هر کسبوکار بیدرنگ بهروز میشود.', viz: 'table' },
  { size: '', icon: ic.link, title: 'نشانیهای خوانا', desc: 'هر کسبوکار یک نشانی تمیز و اشتراکگذاریپذیر میگیرد.', viz: 'urls' },
  { size: 'lg', icon: ic.chart, title: 'تحلیل بازدید', desc: 'روند بازدید صفحه، منابع ورودی و تعامل کاربران را ببینید و بر اساس داده تصمیم بگیرید.', viz: 'chart' },
  { size: 'half', icon: ic.shield, title: 'اعتبارسنجی دستی', desc: 'هر ثبتنامی پیش از انتشار بررسی میشود؛ بدون صف و تبلیغ پنهان.', viz: '' },
  { size: 'half', icon: ic.key, title: 'دسترسی آسان', desc: 'ثبت کسبوکار در کمتر از دو دقیقه، بدون نیاز به دانش فنی.', viz: '' },
];

const checks = [
  'جستجوی فوری بین صدها کسبوکار',
  'فیلتر بر اساس شهر، دستهبندی و امتیاز',
  'صفحات سریع و موبایلپسند برای همه',
  'بهروزرسانی مداوم اطلاعات کسبوکارها',
  'بدون تبلیغ اجباری، بدون رتبه خریداری',
];

const traces = [
  { svc: 'gateway', op: 'GET /api/search', dur: '4ms', o: 14, m: 0, c: '#38bdf8' },
  { svc: 'auth', op: 'verify session', dur: '2ms', o: 9, m: 10, c: '#818cf8' },
  { svc: 'catalog', op: 'query businesses', dur: '11ms', o: 30, m: 21, c: '#a78bfa' },
  { svc: 'rank', op: 'score + sort', dur: '31ms', o: 52, m: 33, c: '#34d399' },
  { svc: 'edge', op: 'render html', dur: '6ms', o: 18, m: 42, c: '#f472b6' },
];

const logs = [
  { time: '14:02:11', level: 'info', msg: 'request received', meta: 'GET /api/search' },
  { time: '14:02:11', level: 'info', msg: 'session verified', meta: 'user_8x2 · oauth' },
  { time: '14:02:11', level: 'info', msg: 'cache miss → catalog', meta: 'region thr-1' },
  { time: '14:02:12', level: 'warn', msg: 'slow query detected', meta: '182ms · idx_fix' },
  { time: '14:02:12', level: 'ok', msg: '12 businesses ranked', meta: 'score p95' },
  { time: '14:02:12', level: 'info', msg: 'response streamed', meta: '200 · 54ms total' },
  { time: '14:02:13', level: 'ok', msg: 'page cached at edge', meta: 'ttl 60s' },
];

const testimonials = [
  { quote: 'با معرفی شدن در بهترینها، مشتریهای جدید ما در ماه اول دو برابر شد. ساده و مؤثر.', name: 'امیر کریمی', role: 'مدیر کارواش رویال، تهران', initial: 'ا', hue: 'a' },
  { quote: 'دقیقترین راهنمای محلی که تا حالا استفاده کردیم. آمار صفحهمان را شفاف نشان میدهند.', name: 'سارا محمدی', role: 'بنیانگذار کافه لمیز، اصفهان', initial: 'س', hue: 'b' },
  { quote: 'مقالات راهنمای رشدشان دقیقاً همان چیزی بود که برای شروع لازم داشتم.', name: 'رضا احمدی', role: 'مالک هتل پارس، شیراز', initial: 'ر', hue: 'c' },
];
---

<Layout title="بهترینها | معرفی بهترین کسبوکارهای شهر شما" description="مرجع کامل معرفی بهترین کسبوکارهای ایران." wide>
  <div class="home">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <a href="/posts/sample-article" class="hero-announce">
          <span class="ha-text">بهترینها ۲٫۰ منتشر شد</span>
          <span class="ha-arrow" aria-hidden="true">←</span>
        </a>
        <h1 class="hero-title">
          بهترین کسبوکارهای شهر شما،
          <br />
          <span class="hero-gradient">در چند ثانیه پیدا کنید</span>
        </h1>
        <p class="hero-sub">
          بهترینها کسبوکارهای برتر ایران را با آمار واقعی و امتیاز کاربران معرفی میکند — سریع، دقیق و بدون تعارف.
        </p>
        <div class="hero-actions">
          <a href="/posts" class="btn btn-primary btn-lg">شروع کنید</a>
          <a href="/posts?q=کارواش" class="btn btn-outline btn-lg">مشاهده دمو ←</a>
        </div>
        <p class="hero-npm" dir="ltr">$ npm create behtarinha@latest</p>
        <div class="hero-window" dir="ltr">
          <div class="win-bar">
            <span class="win-dot"></span><span class="win-dot"></span><span class="win-dot"></span>
            <span class="win-title">behtarinha — zsh</span>
          </div>
          <div class="win-grid">
            <pre class="win-pane win-code"><code><span class="t-cm">// یک جستجو، کل شهر</span>
<span class="t-kw">import</span> &#123; behtarinha &#125; <span class="t-kw">from</span> <span class="t-str">'@behtarinha/core'</span>;

<span class="t-kw">const</span> results = <span class="t-kw">await</span> behtarinha.<span class="t-fn">search</span>(&#123;
  query: <span class="t-str">'بهترین کافیشاپ'</span>,
  city: <span class="t-str">'اصفهان'</span>,
  sort: <span class="t-str">'rating'</span>,
&#125;);

results.<span class="t-fn">forEach</span>((r) =&gt; r.<span class="t-fn">print</span>());</code></pre>
            <pre class="win-pane win-term"><code><span class="t-p">$</span> behtarinha search "کافیشاپ"

<span class="t-ok">✓</span> ۱۲ نتیجه در ۰٫۰۴ ثانیه

 ۱٫ لمیز      <span class="t-star">★ ۴٫۹</span>
 ۲٫ برژان    <span class="t-star">★ ۴٫۸</span>
 ۳٫ گاندو    <span class="t-star">★ ۴٫۷</span>

<span class="t-dim">↑↓ برای انتخاب · Enter برای مشاهده</span></code></pre>
          </div>
          <div class="win-status">
            <span class="ws-item"><span class="ws-dot"></span> connected</span>
            <span class="ws-dim">behtarinha v۲٫۰ · edge · 54ms</span>
          </div>
        </div>
      </div>
    </section>

    <section class="platform">
      <div class="container">
        <div class="sec-head">
          <span class="sec-label" dir="ltr">PLATFORM</span>
          <h2 class="sec-title">همهچیز برای دیده شدن، یکجا</h2>
          <p class="sec-sub">زیرساخت کاملی که کسبوکار شما برای رسیدن به مشتری بعدی نیاز دارد.</p>
        </div>
        <div class="bento">
          {features.map((f) => (
            <article class:list={['bento-card', f.size]}>
              <div class="bc-icon" set:html={f.icon} />
              <h3 class="bc-title">{f.title}</h3>
              <p class="bc-desc">{f.desc}</p>
              {f.viz === 'map' && (
                <div class="viz viz-map" aria-hidden="true">
                  <svg viewBox="0 0 280 150" preserveAspectRatio="xMidYMid slice">
                    <g fill="none" stroke="rgba(139,92,246,0.28)" stroke-width="1">
                      <path d="M40 120 C80 90 90 50 140 45 S230 70 255 35" />
                      <path d="M25 60 C70 55 100 95 150 88 S225 105 262 82" />
                      <path d="M55 138 C110 118 160 128 215 108" />
                      <path d="M18 96 C60 84 130 62 250 122" />
                    </g>
                    <circle cx="140" cy="45" r="34" fill="url(#pulse)" />
                    <circle cx="140" cy="45" r="5" fill="#a78bfa" />
                    {[[68, 92], [212, 58], [58, 74], [228, 112], [104, 116], [186, 94], [36, 44], [248, 66]].map(([cx, cy]) => (
                      <circle cx={cx} cy={cy} r="3" fill="#22d3ee" opacity="0.85" />
                    ))}
                    <defs>
                      <radialGradient id="pulse">
                        <stop offset="0%" stop-color="rgba(167,139,250,0.35)" />
                        <stop offset="100%" stop-color="rgba(167,139,250,0)" />
                      </radialGradient>
                    </defs>
                  </svg>
                </div>
              )}
              {f.viz === 'table' && (
                <div class="viz viz-table" aria-hidden="true" dir="ltr">
                  {[['royal-carwash', '۴٫۹', '+۱۲٪'], ['cafe-lamiz', '۴٫۸', '+۸٪'], ['hotel-pars', '۴٫۷', '+۵٪']].map(([id, rating, delta]) => (
                    <span class="vt-row"><code>{id}</code><b>{rating}</b><i>{delta}</i></span>
                  ))}
                </div>
              )}
              {f.viz === 'urls' && (
                <div class="viz viz-urls" aria-hidden="true" dir="ltr">
                  {['behtarinha.ir/کارواش/رویال', 'behtarinha.ir/کافیشاپ/لمیز'].map((u) => (
                    <span class="vu-row"><span class="vu-lock">🔒</span><code>{u}</code></span>
                  ))}
                </div>
              )}
              {f.viz === 'chart' && (
                <div class="viz viz-chart" aria-hidden="true">
                  <svg viewBox="0 0 300 110" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="rgba(139,92,246,0.32)" />
                        <stop offset="100%" stop-color="rgba(139,92,246,0)" />
                      </linearGradient>
                    </defs>
                    <path d="M0 86 L38 72 L76 80 L114 56 L152 64 L190 38 L228 46 L266 22 L300 30 V110 H0 Z" fill="url(#chartFill)" />
                    <path d="M0 86 L38 72 L76 80 L114 56 L152 64 L190 38 L228 46 L266 22 L300 30" fill="none" stroke="#a78bfa" stroke-width="2" />
                    <circle cx="266" cy="22" r="4" fill="#22d3ee" />
                  </svg>
                  <div class="vc-legend">
                    {[['بازدید صفحه', '#a78bfa'], ['کلیک تماس', '#22d3ee']].map(([label, color]) => (
                      <span class="vc-item"><i style={`background:${color}`} />{label}</span>
                    ))}
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dx">
      <div class="dx-rule" aria-hidden="true"></div>
      <div class="container dx-grid">
        <div class="dx-copy">
          <span class="sec-label" dir="ltr">EXPERIENCE</span>
          <h2 class="sec-title">تجربهای که کاربر برمیگردد</h2>
          <p class="sec-sub">همهچیز برای یافتن سریع و تصمیم مطمئن فراهم است.</p>
          <ul class="dx-checks">
            {checks.map((c) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="editor" aria-hidden="true">
          <div class="ed-tabs">
            {['جستجو', 'فیلترها', 'ذخیرهشدهها'].map((t, i) => (
              <button type="button" class:list={['ed-tab', i === 0 ? 'is-active' : '']}>{t}</button>
            ))}
            <div class="ed-dots"><span /><span /><span /></div>
          </div>
          <pre class="ed-body" dir="ltr"><code><span class="t-cm">// جستجوی زنده</span>
<span class="t-kw">const</span> q = behtarinha.<span class="t-fn">query</span>(&#123;
  city:   <span class="t-str">'تهران'</span>,
  min:    <span class="t-num">4.5</span>,
  open:   <span class="t-bool">true</span>,
&#125;);

q.<span class="t-fn">filter</span>(<span class="t-str">'کارواش'</span>).<span class="t-fn">limit</span>(<span class="t-num">10</span>);

<span class="t-ok">✓</span> <span class="t-num">10</span> matches · <span class="t-num">38ms</span></code></pre>
        </div>
      </div>
    </section>

    <section class="obs">
      <div class="obs-rule" aria-hidden="true"></div>
      <div class="container obs-grid">
        <div class="obs-copy">
          <span class="sec-label" dir="ltr">OBSERVABILITY</span>
          <h2 class="sec-title">شفافیت کامل، اعتماد کامل</h2>
          <p class="sec-sub">هر امتیاز قابل ردیابی است؛ از اولین بازدید تا آخرین بهروزرسانی.</p>
          <a href="/posts" class="btn btn-outline btn-sm obs-link">مشاهده روش امتیازدهی ←</a>
        </div>

        <div class="obs-panel" dir="ltr">
          <div class="obs-tabs">
            <span class="obs-tab is-active">Traces</span>
            <span class="obs-tab">Metrics</span>
            <span class="obs-tab">Logs</span>
          </div>

          <div class="trace">
            {traces.map((tr) => (
              <div class="tr-row">
                <span class="tr-svc">{tr.svc}</span>
                <span class="tr-op">{tr.op}</span>
                <span class="tr-lane">
                  <i style={`margin-left:${tr.o}%;width:${tr.m}%;background:${tr.c}`} />
                </span>
                <span class="tr-dur">{tr.dur}</span>
              </div>
            ))}
            <div class="tr-axis"><span>0ms</span><span>25ms</span><span>50ms</span></div>
          </div>

          <div class="logbox">
            <div class="lb-head"><span class="lb-dot" /> live logs — production</div>
            {logs.map((l) => (
              <p class="lb-line">
                <span class="lb-time">{l.time}</span>
                <span class:list={['lb-level', `lv-${l.level}`]}>{l.level.toUpperCase()}</span>
                <span class="lb-msg">{l.msg} <span class="lb-meta">{l.meta}</span></span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="testimonials">
      <div class="container">
        <div class="sec-head">
          <span class="sec-label" dir="ltr">TESTIMONIALS</span>
          <h2 class="sec-title">صاحبان کسبوکار چه میگویند</h2>
          <p class="sec-sub">بیش از ۲۵۰ کسبوکار در بهترینها ثبت شدهاند.</p>
        </div>
        <div class="testi-grid">
          {testimonials.map((t) => (
            <figure class="testi-card">
              <blockquote><p>«{t.quote}»</p></blockquote>
              <figcaption>
                <span class:list={['testi-avatar', `ta-${t.hue}`]}>{t.initial}</span>
                <span class="testi-who"><strong>{t.name}</strong><small>{t.role}</small></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="container cta-inner">
        <h2 class="cta-title">
          کسبوکار شما دیده شدن را
          <br />
          <span class="hero-gradient">لیاقتش را دارد</span>
        </h2>
        <p class="cta-sub">در چند دقیقه ثبت کنید؛ بینندههای بیشتری جذب کنید.</p>
        <div class="cta-actions">
          <a href="/posts" class="btn btn-primary btn-lg">همین حالا شروع کنید</a>
          <a href="/posts?q=کافیشاپ" class="btn btn-outline btn-lg">مشاهده نمونهها</a>
        </div>
        <ul class="cta-points">
          {[['رایگان', 'بدون هزینه اولیه'], ['سریع', 'راهاندازی زیر ۲ دقیقه'], ['مقیاسپذیر', 'از یک مغازه تا یک زنجیره']].map(([b, s]) => (
            <li><strong>{b}</strong><span>{s}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ═══ Shared / tokens ═══ */
  .home {
    --grad-text: linear-gradient(100deg, #a5b4fc 0%, #c4b5fd 45%, #67e8f9 100%);
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    overflow: clip;
  }

  .sec-head {
    max-width: 660px;
    margin: 0 auto var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .sec-label {
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.22em;
    color: var(--text-accent);
  }

  .sec-title {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--text-primary);
  }

  .sec-sub {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* Syntax tokens (shared by all code panes) */
  .t-kw { color: #c4b5fd; }
  .t-str { color: #7dd3fc; }
  .t-fn { color: #67e8f9; }
  .t-cm { color: rgba(160, 160, 180, 0.55); font-style: italic; }
  .t-num { color: #fda4af; }
  .t-bool { color: #fca5a5; }
  .t-ok { color: #34d399; }
  .t-star { color: #fbbf24; }
  .t-p { color: #22d3ee; font-weight: 600; }
  .t-dim { color: rgba(160, 160, 180, 0.6); }
  /* ═══ Hero ═══ */
  .hero {
    position: relative;
    isolation: isolate;
    padding: var(--space-16) 0 var(--space-14);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 42% at 50% -6%, rgba(99, 102, 241, 0.16) 0%, transparent 62%),
      radial-gradient(ellipse 40% 30% at 78% 18%, rgba(34, 211, 238, 0.07) 0%, transparent 65%),
      linear-gradient(to bottom, rgba(139, 92, 246, 0.05), transparent 32%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 72% 58% at 50% 8%, black 26%, transparent 74%);
    mask-image: radial-gradient(ellipse 72% 58% at 50% 8%, black 26%, transparent 74%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-announce {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2-5);
    padding: 5px var(--space-2) 5px var(--space-4);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-full);
    background: rgba(139, 92, 246, 0.08);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .hero-announce:hover {
    border-color: var(--border-accent-hover);
    color: var(--text-primary);
  }

  .ha-arrow {
