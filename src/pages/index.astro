---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const categories = [
  { name: 'کافیشاپ', slug: 'کافیشاپ', icon: '☕', count: '۳۴' },
  { name: 'رستوران', slug: 'رستوران', icon: '🍽️', count: '۵۲' },
  { name: 'کارواش', slug: 'کارواش', icon: '🚗', count: '۲۸' },
  { name: 'آرایشگاه', slug: 'آرایشگاه', icon: '💇', count: '۴۱' },
  { name: 'باشگاه', slug: 'باشگاه', icon: '🏋️', count: '۱۹' },
  { name: 'هتل', slug: 'هتل', icon: '🏨', count: '۱۲' },
];

const cities = ['تهران', 'اصفهان', 'مشهد', 'شیراز', 'تبریز', 'کرج', 'یزد', 'رشت'];

const stats = [
  { value: '+۲۵۰', label: 'کسبوکار ثبتشده' },
  { value: '۸', label: 'شهر تحت پوشش' },
  { value: '+۱۲۰', label: 'مقاله آموزشی' },
  { value: '۴٫۸', label: 'میانگین رضایت' },
];

const testimonials = [
  {
    quote: 'با معرف شدن در بهترینها، مشتریهای جدید ما در ماه اول دو برابر شد. ساده و مؤثر.',
    name: 'امیر کریمی',
    role: 'مدیر کارواش رویال، تهران',
    initial: 'ا',
  },
  {
    quote: 'دقیقترین راهنمای محلی که تا حالا استفاده کردیم. آمار صفحهمان را شفاف نشان میدهند.',
    name: 'سارا محمدی',
    role: 'بنیانگذار کافه لمیز، اصفهان',
    initial: 'س',
  },
  {
    quote: 'مقالات راهنمای رشدشان دقیقاً همان چیزی بود که برای شروع لازم داشتم.',
    name: 'رضا احمدی',
    role: 'مالی هتل پارس، شیراز',
    initial: 'ر',
  },
];

const recentArticles = [
  { title: 'چگونه مقالهای مؤثر بنویسیم؟', slug: 'sample-article', excerpt: 'راهنمای عملی برای نوشتن مقالات واضح، خوانا و حرفهای.', city: 'تهران', category: 'مقالات' },
  { title: 'بهترین کارواشهای اصفهان', slug: 'بهترین-کارواش-اصفهان', excerpt: 'لیست کاملی از بهترین کارواشهای اصفهان...', city: 'اصفهان', category: 'کارواش' },
  { title: 'ارزانترین رستورانهای تهران', slug: 'ارزان-رستوران-تهران', excerpt: 'معرفی رستورانهای اقتصادی تهران...', city: 'تهران', category: 'رستوران' },
];
---

<Layout title="بهترینها | معرفی بهترین کسبوکارهای شهر شما" description="مرجع کامل معرفی بهترین کسبوکارهای ایران.">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-badge">بهترینها ۲٫۰ — حالا در ۸ شهر ایران <span aria-hidden="true">←</span></span>
          <h1 class="hero-title">بهترین کسبوکارهای شهرتان،<br /><span class="hero-title-accent">در چند ثانیه</span></h1>
          <p class="hero-sub">
            بهترینها کسبوکارهای برتر ایران را با آمار واقعی، امتیاز کاربران و راهنمای کامل معرفی میکند — سریع، دقیق و بدون تعارف.
          </p>
          <div class="hero-actions">
            <a href="/posts" class="btn btn-primary btn-lg">شروع جستجو</a>
            <a href="/posts/sample-article" class="btn btn-outline btn-lg">مشاهده نمونه بررسی</a>
          </div>
          <p class="hero-trust-note">بدون نیاز به ثبتنام · رایگان برای همیشه</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="terminal">
            <div class="terminal-bar">
              <span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span>
              <span class="terminal-title" dir="ltr">behtarinha — search</span>
            </div>
            <pre class="terminal-body" dir="ltr"><code><span class="t-prompt">$</span> behtarinha search <span class="t-str">"کارواش"</span> <span class="t-flag">--city</span> تهران

<span class="t-ok">✓</span> 12 results found <span class="t-dim">(0.04s)</span>

1. carwash royal    <span class="t-star">★ 4.9</span>   Tehran
2. carwash pars     <span class="t-star">★ 4.7</span>   Karaj
3. wash express     <span class="t-star">★ 4.5</span>   Isfahan<span class="t-cursor"></span></code></pre>
            <div class="terminal-stats">
              <span dir="ltr">0.04s avg</span><i></i><span>۸ شهر</span><i></i><span>+۲۵۰ کسبوکار</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trustbar">
    <div class="container">
      <p class="trust-label">مورد اعتماد کسبوکارهای برتر در سراسر ایران</p>
      <ul class="trust-cities" aria-label="شهرهای تحت پوشش">
        {cities.map(c => (<li>{c}</li>))}
      </ul>
    </div>
  </section>
  <!-- Categories / Features Grid -->
  <section class="cats">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">دستهبندیها را کاوش کنید</h2>
        <p class="section-sub">هر کسبوکار با امتیاز واقعی کاربران، موقعیت و جزئیات کامل معرفی میشود.</p>
      </div>
      <div class="cats-grid">
        {categories.map(c => (
          <a href={`/posts?q=${encodeURIComponent(c.name)}`} class="cat-card">
            <span class="cat-icon" aria-hidden="true">{c.icon}</span>
            <span class="cat-name">{c.name}</span>
            <span class="cat-count">{c.count} کسبوکار</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-cell">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="articles">
    <div class="container">
      <div class="section-head row">
        <div>
          <h2 class="section-title">مقالات جدید</h2>
          <p class="section-sub">راهنماها و بررسیهای تخصصی برای انتخاب بهتر.</p>
        </div>
        <a href="/posts" class="view-all">مشاهده همه ←</a>
      </div>
      <div class="articles-grid">
        {recentArticles.map(article => (
          <a href={`/posts/${article.slug}`} class="article-card">
            <span class="article-cat">{article.category}</span>
            <h3 class="article-title">{article.title}</h3>
            <p class="article-excerpt">{article.excerpt}</p>
            <span class="article-meta">{article.city} · {article.category}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">کسبوکارها چه میگویند</h2>
        <p class="section-sub">نظر صاحبان کسبوکارهایی که در بهترینها معرفی شدهاند.</p>
      </div>
      <div class="testi-grid">
        {testimonials.map(t => (
          <figure class="testi-card">
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <span class="testi-avatar" aria-hidden="true">{t.initial}</span>
              <span class="testi-who">
                <strong>{t.name}</strong>
                <small>{t.role}</small>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta">
    <div class="container">
      <div class="cta-banner">
        <h2 class="cta-title">کسبوکارتان را به بهترینها بیاورید</h2>
        <p class="cta-sub">رایگان معرفی شوید و مشتریهای جدید را از همین هفته جذب کنید.</p>
        <div class="cta-actions">
          <a href="/posts" class="btn btn-primary btn-lg">شروع کنید</a>
          <a href="/posts/sample-article" class="btn btn-outline btn-lg">یک نمونه ببینید</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────── */
  .hero { padding: 5rem 0 4rem; }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 4rem; }
    .hero { padding: 7rem 0 5rem; }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1-5) var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-5) 0;
  }

  .hero-title-accent { color: var(--text-brand); }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8) 0;
    max-width: 34rem;
  }

  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  .hero-trust-note {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Terminal mockup */
  .terminal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow: var(--shadow-lg);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-primary);
  }

  .dot { width: 10px; height: 10px; border-radius: var(--radius-full); }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .terminal-title {
    margin-inline-start: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .terminal-body {
    margin: 0;
    padding: var(--space-5);
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--text-primary);
    overflow-x: auto;
    text-align: left;
  }

  .t-prompt { color: var(--text-accent); }
  .t-str { color: #a5d6a7; }
  .t-flag { color: var(--text-brand); }
  .t-ok { color: #66bb6a; }
  .t-dim { color: var(--text-muted); }
  .t-star { color: #fdd835; }

  .t-cursor::after {
    content: '▋';
    color: var(--interactive-primary);
    animation: blink 1.2s steps(2) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .terminal-stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--border-primary);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .terminal-stats i { flex: 0 0 1px; height: 12px; background: var(--border-secondary); }

  /* ── Trust bar ────────────────────────── */
  .trustbar {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
  }

  .trust-label {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-5) 0;
  }

  .trust-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-tertiary);
  }

  /* ── Sections shared ──────────────────── */
  section.cats, section.stats, section.articles, section.testimonials { padding: var(--space-20) 0; }
  section.cta { padding: var(--space-8) 0 var(--space-16); }

  .section-head { max-width: 40rem; margin-bottom: var(--space-12); }
  .section-head.row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .section-title {
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .section-sub { color: var(--text-secondary); margin: 0; }

  .view-all {
    font-size: var(--text-sm);
    color: var(--text-brand);
    text-decoration: none;
    white-space: nowrap;
  }

  .view-all:hover { color: var(--interactive-primary-hover); }

  /* ── Categories grid ──────────────────── */
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 768px) { .cats-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .cats-grid { grid-template-columns: repeat(6, 1fr); } }

  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .cat-card:hover { border-color: var(--border-secondary); transform: translateY(-2px); }

  .cat-icon { font-size: 1.75rem; line-height: 1; }
  .cat-name { font-weight: var(--font-weight-medium); color: var(--text-primary); }
  .cat-count { font-size: var(--text-xs); color: var(--text-muted); }

  /* ── Stats ────────────────────────────── */
  .stats {
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    padding: var(--space-12) 0 !important;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 768px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .stat-cell { display: flex; flex-direction: column; gap: var(--space-1); }

  .stat-value {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .stat-label { font-size: var(--text-sm); color: var(--text-muted); }

  /* ── Articles ─────────────────────────── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .article-card:hover { border-color: var(--border-secondary); }

  .article-cat {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--text-brand);
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: var(--radius-full);
    padding: 2px var(--space-3);
  }

  .article-title { font-size: var(--text-lg); font-weight: var(--font-weight-semibold); margin: 0; color: var(--text-primary); }
  .article-excerpt { font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); margin: 0; }
  .article-meta { font-size: var(--text-xs); color: var(--text-muted); margin-top: auto; }

  /* ── Testimonials ─────────────────────── */
  .testi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) { .testi-grid { grid-template-columns: repeat(3, 1fr); } }

  .testi-card {
    margin: 0;
    padding: var(--space-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .testi-card blockquote {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
  }

  .testi-card figcaption { display: flex; align-items: center; gap: var(--space-3); margin-top: auto; }

  .testi-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--bg-quaternary);
    border: 1px solid var(--border-secondary);
    color: var(--text-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-bold);
    flex-shrink: 0;
  }

  .testi-who { display: flex; flex-direction: column; }
  .testi-who strong { font-size: var(--text-sm); color: var(--text-primary); font-weight: var(--font-weight-semibold); }
  .testi-who small { font-size: var(--text-xs); color: var(--text-muted); }

  /* ── Final CTA ────────────────────────── */
  .cta-banner {
    padding: var(--space-16) var(--space-6);
    background:
      radial-gradient(ellipse at 50% 120%, rgba(139, 92, 246, 0.14) 0%, transparent 60%),
      var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .cta-title { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-tight); margin: 0; }
  .cta-sub { color: var(--text-secondary); margin: 0 0 var(--space-4) 0; }
  .cta-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; }

  @media (max-width: 768px) {
    .hero { padding: 3rem 0 2rem; }
    section.cats, section.stats, section.articles, section.testimonials { padding: var(--space-14) 0; }
    section.cta { padding: var(--space-4) 0 var(--space-12); }
  }
</style>
