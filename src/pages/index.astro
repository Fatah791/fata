---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

// داده‌های نمونه برای تست طراحی (بعداً از Keystone گرفته می‌شود)
const featuredCities = [
  { name: 'اصفهان', slug: 'اصفهان', image: 'https://picsum.photos/seed/isfahan/400/300', count: 120 },
  { name: 'تهران', slug: 'تهران', image: 'https://picsum.photos/seed/tehran/400/300', count: 250 },
  { name: 'شیراز', slug: 'شیراز', image: 'https://picsum.photos/seed/shiraz/400/300', count: 95 },
  { name: 'مشهد', slug: 'مشهد', image: 'https://picsum.photos/seed/mashhad/400/300', count: 180 },
];

const categories = [
  { name: 'کافی‌شاپ', slug: 'کافی-شاپ', icon: '☕' },
  { name: 'رستوران', slug: 'رستوران', icon: '🍽️' },
  { name: 'کارواش', slug: 'کارواش', icon: '🚗' },
  { name: 'آرایشگاه', slug: 'آرایشگاه', icon: '💇' },
  { name: 'باشگاه', slug: 'باشگاه', icon: '🏋️' },
  { name: 'هتل', slug: 'هتل', icon: '🏨' },
];

const recentArticles = [
  { 
    title: 'چگونه مقاله‌ای مؤثر بنویسیم؟',
    slug: 'sample-article',
    excerpt: 'راهنمای عملی برای نوشتن مقالات واضح، خوانا و حرفه‌ای — شامل ساختار، پاراگراف‌بندی و مثال‌های عملی.',
    city: 'تهران',
    category: 'مقالات'
  },
  { 
    title: 'بهترین کارواش‌های اصفهان - راهنمای کامل ۱۴۰۳', 
    slug: 'بهترین-کارواش-اصفهان',
    excerpt: 'لیست کاملی از بهترین و ارزان‌ترین کارواش‌های اصفهان با آدرس و شماره تماس...',
    city: 'اصفهان',
    category: 'کارواش'
  },
  { 
    title: 'ارزان‌ترین رستوران‌های تهران با کیفیت عالی', 
    slug: 'ارزان-رستوران-تهران',
    excerpt: 'معرفی رستوران‌های اقتصادی تهران که کیفیت غذای فوق‌العاده‌ای دارند...',
    city: 'تهران',
    category: 'رستوران'
  },
  { 
    title: 'لوکس‌ترین کافی‌شاپ‌های شیراز کجاست؟', 
    slug: 'لوکس-کافی-شاپ-شیراز',
    excerpt: 'اگر به دنبال تجربه‌ای خاص در شیراز هستید، این کافی‌شاپ‌ها را از دست ندهید...',
    city: 'شیراز',
    category: 'کافی‌شاپ'
  },
];
---

<Layout 
  title="بهترین‌ها | معرفی بهترین کسب‌وکارهای شهر شما"
  description="سایت بهترین‌ها - مرجع کامل معرفی بهترین کسب‌وکارهای ایران. بهترین رستوران‌ها، کافی‌شاپ‌ها، کارواش‌ها و خدمات هر شهر را اینجا پیدا کنید."
>
  <!-- Hero (modern) -->
  <section class="page-hero">
    <div class="hero-card">
      <h1 class="text-4xl font-extrabold mb-3">بهترین‌ها — راهنمای جامع محلی و مقالات آموزشی</h1>
      <p class="text-muted mb-6">پایگاهی برای یافتن بهترین کسب‌وکارها، خواندن مقالات تخصصی و یادگیری روش‌های کاربردی برای رشد کسب‌وکار.</p>

      <div class="flex gap-3 flex-col sm:flex-row">
        <a href="/posts/sample-article" class="btn btn-primary">مطالعهٔ نمونه</a>
        <a href="/posts" class="btn btn-outline">تمام مقالات</a>
      </div>
    </div>

    <div class="hero-card">
      <h4 class="font-bold mb-3">جستجوی سریع</h4>
      <form class="flex gap-2">
        <input placeholder="چه چیزی می‌خواهید پیدا کنید؟" class="flex-1 px-4 py-3 rounded-lg bg-surface border border-white/6 text-text" />
        <button class="btn btn-primary">جستجو</button>
      </form>

      <div class="mt-6">
        <h5 class="text-sm text-muted mb-2">دسته‌های محبوب</h5>
        <div class="flex flex-wrap gap-2">
          {categories.map(c => (
            <a href={`/category/${c.slug}`} class="px-3 py-2 rounded-lg bg-card text-muted text-sm border border-white/6">{c.icon} {c.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="py-12">
    <div class="container">
      <h2 class="text-2xl font-bold mb-6">مقالات جدید</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recentArticles.map(article => (
          <a href={`/posts/${article.slug}`} class="article-card p-5">
            <h3 class="font-bold text-lg text-white mb-2">{article.title}</h3>
            <p class="text-muted text-sm mb-4">{article.excerpt}</p>
            <div class="text-sm text-muted">{article.city} • {article.category}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer slot -->
  <slot name="footer">
    <!-- default footer -->
    <Footer />
  </slot>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
