```gitignore
# Build artifacts
dist/
build/
*.js
*.ts
*.jsx
*.tsx

# Dependencies
node_modules/

# Cache directories
.cache/
.output/

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.log

# Astro-specific
.astroturf/
```