{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": false,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.astro", "keystatic.config.ts", ".astro/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}